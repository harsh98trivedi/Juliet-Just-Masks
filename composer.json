{
  "name": "harsh98trivedi/juliet-just-mask",
  "description": "URL masking, mask manager, and stealth reverse proxy companion for Romeo Redirect Manager.",
  "type": "wordpress-plugin",
  "keywords": [
    "wordpress",
    "plugin",
    "url-masking",
    "mask-manager",
    "reverse-proxy",
    "url-masker",
    "stealth-routing",
    "spa-proxy",
    "landing-page-masking"
  ],
  "homepage": "https://wordpress.org/plugins/juliet-just-mask/",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "Harsh Trivedi",
      "homepage": "https://harsh98trivedi.github.io/",
      "role": "Developer"
    }
  ],
  "support": {
    "issues": "https://wordpress.org/support/plugin/juliet-just-mask/",
    "source": "https://github.com/harsh98trivedi/juliet-just-mask"
  },
  "require": {
    "php": ">=7.4"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "wp-coding-standards/wpcs": "^3.0",
    "phpcompatibility/phpcompatibility-wp": "^2.1"
  },
  "scripts": {
    "lint": "phpcs -p -s -v --standard=phpcs.xml.dist .",
    "format": "phpcbf -p -s -v --standard=phpcs.xml.dist ."
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
